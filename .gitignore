# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Test / type / lint caches
.pytest_cache/
.pytest-cache-workspace/
.pytest-tmp/
/.test-tmp/
/.t/
.mypy_cache/
.ruff_cache/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local behavioral eval artifacts (may contain opt-in transcripts)
/.eval/

# Virtualenvs
.venv/
.venv-analysis/
.conda/

# Secrets
.env
.env.*
!.env.example
!.env.e2e

# Session / runtime data
*.jsonl

# Node / frontend build
node_modules/
src/pi_agent_core_py/web/static/assets/
src/pi_agent_core_py/web/static/index.html

# Real-env dev data (persistent sqlite + uploads from local dev runs)
dev_data/
/.pi-agent-data/
/.run-logs/

# Runtime uploads from local web runs (root-anchored to avoid hitting test fixtures)
/uploads/

# Runtime uploads from local web runs when backend launched with cwd at frontend
# (VirtualFileStore default is "./uploads" — cwd-relative). Precise path to avoid
# colliding with future test fixtures or example dirs.
/src/pi_agent_core_py/web/frontend/uploads/

# Dev-mode sqlite from local web runs (created by uvicorn in CWD)
dev_sessions.db
dev_sessions.db-shm
dev_sessions.db-wal

# Playwright e2e artifacts (trace / screenshot / video on failure)
tests/e2e/test-results/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local state (CLAUDE.md at repo root IS committed)
.claude/settings.local.json
# Playwright authentication state contains an active session cookie.
tests/e2e/.auth/
