{
  "name": "pi-agent-core-py-e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Playwright E2E smoke tests for Web Claude P0 MVP. Independent npm env — does not pollute frontend build.",
  "scripts": {
    "pretest:e2e": "npm --prefix ../../src/pi_agent_core_py/web/frontend run build:e2e",
    "test:e2e": "playwright test",
    "posttest:e2e": "npm --prefix ../../src/pi_agent_core_py/web/frontend run build",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
